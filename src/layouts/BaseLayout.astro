---
import { SITE } from "../data/site";
const { title, description = SITE.description, canonical, image } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.brand}` : SITE.name;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const socialImage = image ?? new URL("/og-default.svg", SITE.url).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#f7f7f4" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="GreyStudio Journal RSS" href="/rss.xml" />
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="wordmark" href="/">GREYSTUDIO<span>.</span></a>
        <p>Ideas and practical guides for businesses building their next chapter.</p>
        <a class="footer-main-link" href="https://greystudio.online/">Visit GreyStudio main website ↗</a>
        <span>© {new Date().getFullYear()} GreyStudio · Hyderabad, India</span>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
  :root{font-family:'DM Sans',sans-serif;color:#171717;background:#f7f7f4;font-synthesis:none;text-rendering:optimizeLegibility}
  *{box-sizing:border-box}
  body{margin:0}
  a{color:inherit;text-decoration:none}
  .shell{width:min(1160px,calc(100% - 48px));margin:auto}
  .masthead{border-bottom:1px solid #e3e3dd;background:#f7f7f4}
  .nav{height:78px;display:flex;align-items:center;justify-content:space-between;gap:28px}
  .wordmark{font:800 17px Manrope,sans-serif;letter-spacing:-.08em}
  .wordmark span{color:#a5a59b}
  .nav-links{display:flex;gap:22px;align-items:center;flex-wrap:wrap;font-size:12px;color:#55564f}
  .nav-links a:hover,.text-link:hover{color:#8a5b3c}
  .eyebrow{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#8a5b3c;font-weight:700}
  h1,h2,h3{font-family:Manrope,sans-serif;letter-spacing:-.055em}
  .hero{padding:92px 0 84px;display:grid;grid-template-columns:1.25fr .75fr;gap:70px;align-items:end}
  .hero h1{font-size:clamp(46px,7vw,82px);line-height:.98;margin:20px 0 24px;max-width:760px}
  .hero p{font-size:17px;line-height:1.7;color:#66665e;max-width:590px}
  .hero-note{border-left:1px solid #c9c9bd;padding:8px 0 8px 24px;color:#68685f;font-size:13px;line-height:1.8}
  .section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:0 0 24px}
  .section-head h2{font-size:30px;margin:0}
  .article-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .article-card{background:#fff;border:1px solid #e9e9e3;padding:26px;min-height:270px;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}
  .article-card:hover{transform:translateY(-3px);border-color:#c9b6a5}
  .article-card h3{font-size:23px;line-height:1.2;margin:18px 0 12px}
  .article-card p{font-size:13px;line-height:1.7;color:#77776f;margin:0 0 24px}
  .meta{font-size:10px;color:#8b8b82;letter-spacing:.08em;text-transform:uppercase}
  .text-link{font-size:12px;font-weight:700;margin-top:auto}
  .category-strip{padding:72px 0 88px}
  .category-list{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid #deded7}
  .category-link{padding:22px 16px 22px 0;border-bottom:1px solid #deded7;font:600 15px Manrope;display:flex;justify-content:space-between}
  .site-footer{background:#1d1d1a;color:#f5f5ef;padding:42px 0}
  .footer-inner{width:min(1160px,calc(100% - 48px));margin:auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
  .footer-inner p,.footer-inner span{font-size:11px;color:#b8b8af}
  .footer-main-link{font-size:11px;font-weight:600;color:#f5f5ef;text-decoration:underline;text-underline-offset:4px}
  .footer-main-link:hover{color:#c9b6a5}
  .page-head{padding:70px 0 42px}
  .page-head h1{font-size:clamp(38px,5vw,60px);margin:14px 0}
  .page-head p{color:#6e6e66;max-width:650px;line-height:1.7}
  .listing{padding:0 0 90px}
  .post{width:min(760px,calc(100% - 48px));margin:auto;padding:68px 0 100px}
  .post h1{font-size:clamp(40px,6vw,64px);line-height:1.05;margin:18px 0}
  .post .dek{font-size:19px;line-height:1.7;color:#66665f}
  .post-content{margin-top:48px;font-size:17px;line-height:1.85;color:#3d3d38}
  .post-content h2,.post-content h3{color:#171717;line-height:1.2;margin-top:2em}
  .post-content h2{font-size:30px}
  .post-content h3{font-size:22px}
  .post-content a{color:#8a5b3c;text-decoration:underline;text-underline-offset:3px}
  .post-content ul,.post-content ol{padding-left:24px}
  .post-content blockquote{border-left:2px solid #aa8060;margin:28px 0;padding:2px 0 2px 22px;color:#696960}
  .post-content img{max-width:100%;height:auto}
  .post-nav{display:flex;gap:16px;justify-content:space-between;border-top:1px solid #deded7;padding-top:24px;margin-top:52px;font-size:13px}
  @media(max-width:800px){.nav{height:auto;padding:22px 0;align-items:flex-start;flex-direction:column}.nav-links{gap:12px}.hero{grid-template-columns:1fr;gap:24px;padding:66px 0}.article-grid{grid-template-columns:1fr 1fr}.category-list{grid-template-columns:1fr 1fr}}
  @media(max-width:540px){.shell{width:min(100% - 32px,1160px)}.article-grid,.category-list{grid-template-columns:1fr}.article-card{min-height:220px}.hero h1{font-size:49px}.footer-inner{width:calc(100% - 32px)}}
</style>

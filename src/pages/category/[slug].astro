---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { CATEGORIES } from "../../data/site";
export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}
const { category } = Astro.props;
const all = await getCollection("articles", ({ data }) => !data.draft);
const articles = all.filter((a) => a.data.category === category.name).sort((a,b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout title={category.name} description={category.intro}>
  <SiteHeader />
  <main class="shell">
    <header class="page-head"><span class="eyebrow">Category · GreyStudio Journal</span><h1>{category.name}</h1><p>{category.intro}</p></header>
    <section class="listing">
      {articles.length ? <div class="article-grid">{articles.map((article) => <a class="article-card" href={`/articles/${article.id}/`}><span class="meta">{article.data.publishDate.toLocaleDateString("en-IN",{day:"numeric",month:"short",year:"numeric"})}</span><h3>{article.data.title}</h3><p>{article.data.description}</p><span class="text-link">Read article ↗</span></a>)}</div> : <p>New articles in this category are coming soon.</p>}
    </section>
  </main>
</BaseLayout>
